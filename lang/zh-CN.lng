[MENU307]
1=\n	换行符
2=\t	制表符
4=^	行头
5=$	行尾
6=.	任意字符
7=\b	字符边界
8=\x00	2字节字符
9=\u0000	4字节字符
10=\w	单词(A-Z, a-z, 0-9, _)
11=\W	非单词
12=\s	空白字符
13=\S	非空白字符
14=\d	数字(0-9)
15=\D	非数字
17=[]	字符集合
18=[^]	字符集合之外
19=()	子表达式分组
20=|	或
21={n}	n次
22={n,}	多于n次
23={n,m}	n~m次
24=*	0次或多次
25=+	1次或多次
26=?	0次或1次
28=(?=exp)	正向预搜索
29=(?!exp)	正向预搜索否定
30=(?<=exp)	反向预搜索
31=(?<!exp)	反向预搜索否定
201=\c	汉字
202=\j	平假名
203=\J	片假名
204=\P	CJK符号和标点
230=[:alnum:]	任何一个字母或数字(A-Z,a-z,0-9)
231=[:alpha:]	任何一个字母(A-Z,a-z)
232=[:ascii:]	任何一个 ASCII 范围内字符(x00-x7F)
233=[:cntrl:]	任何一个控制字符(x00-x1F,x7F)
234=[:digit:]	任何一个数字(0–9)
235=[:print:]	任何一个可显示的 ASCII 字符(x20-x7E)
236=[:space:]	任何一个空白字符(x09-x0D,x20)
237=[:graph:]	任何一个可显示的 ASCII 字符,不包含空格(x21-x7E)
238=[:lower:]	任何一个小写字母(a-z)
239=[:punct:]	可显示字符[:print:]中除去字母数字[:alnum:]
240=[:upper:]	任何一个大写字母(A-Z)
241=[:blank:]	空格或者制表符(x20,x09)
245=[:xdigit:]	任何一个十六进制数字(0-9,A-F,a-f)
P201=更多...

