[MENU307]
1=\n	New line
2=\t	Tab
4=^	Beginning of line
5=$	End of line
6=.	Any character
7=\b	Word boundary
8=\x00	Char (2 byte hex)
9=\u0000	Char (4 byte hex)
10=\w	Words (A-Z, a-z, 0-9, _)
11=\W	Non-words
12=\s	Whitespaces
13=\S	Non-whitespaces
14=\d	Digit (0-9)
15=\D	Non-digit
17=[]	Character in set
18=[^]	Character not in set
19=()	Group
20=|	Or
21={n}	n times
22={n,}	More than n times
23={n,m}	n~m times
24=*	0 or more matches
25=+	1 or more matches
26=?	0 or 1 matches
28=(?=exp)	Match after
29=(?!exp)	Not match after
30=(?<=exp)	Match before
31=(?<!exp)	Not match before
201=\c	Chinese
202=\j	Hiragana
203=\J	Katakana
204=\P	CJK symbols and punctuation
230=[:alnum:]	Any alphanumeric character
231=[:alpha:]	Any alphabetical character a-z, A-Z, and other character
232=[:ascii:]	Any ASCII character (0x00~0x7F)
233=[:cntrl:]	Any control character
234=[:digit:]	Any digit 0-9
235=[:print:]	Any printable character
236=[:space:]	Any whitespace character
237=[:graph:]	Any graphical character
238=[:lower:]	Any lowercase character a-z, and other lowercase character
239=[:punct:]	Any punctuation character
240=[:upper:]	Any uppercase character A-Z, and other uppercase character
241=[:blank:]	Any blank character, either a space or a tab
245=[:xdigit:]	Any hexadecimal digit character, 0-9, a-f and A-F
